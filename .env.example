# OpenRouter (solo modelos :free)
OPENROUTER_API_KEY=sk-or-v1-xxxxx
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_MODEL=google/gemma-4-31b-it:free
# LLM_MOCK=true   # respuestas de ejemplo sin gastar cuota
# LLM_CACHE=false # desactiva la caché de respuestas

# Base de datos (docker compose)
DATABASE_URL=postgresql://estimador:estimador@localhost:5433/estimador

# API
API_PORT=3000
