{
  "name": "estimador-propuestas",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run start:dev -w @estimador/api\" \"npm run dev -w @estimador/web\"",
    "dev:api": "npm run start:dev -w @estimador/api",
    "dev:web": "npm run dev -w @estimador/web",
    "db:migrate": "npm run db:migrate -w @estimador/api",
    "db:seed": "npm run db:seed -w @estimador/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
